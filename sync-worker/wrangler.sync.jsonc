{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rf-mcp-cache-sync",
  "main": "src/sync-worker.js",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  // Disable the default workers.dev subdomain — sync-worker is reachable only via
  // service binding (from main worker) and cron triggers. This closes off the
  // https://rf-mcp-cache-sync.<account>.workers.dev/* public surface.
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "RF_MCP_CACHE",
      "database_name": "rf-mcp-cache",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    },
    // USERS_DB is read-only here — main worker owns the schema (see ../CLAUDE.md "D1 ownership").
    {
      "binding": "USERS_DB",
      "database_name": "rf-users",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_STATE",
      "id": "REDACTED_KV_NAMESPACE_ID"
    }
  ],
  "workflows": [
    {
      "binding": "REBUILD_WORKFLOW",
      "name": "rf-mcp-rebuild",
      "class_name": "FullRebuildWorkflow"
    },
    // PIPELINE_REBUILD_WORKFLOW intentionally kept in the binding list so the
    // exported `PipelineRebuildWorkflow` class still has its registered name
    // (Workflows require a binding pointing at the class). The cron path no
    // longer spawns instances; this class is dead infrastructure pending the
    // cutover step 6 cleanup that drops `job_pipelines` and removes the class.
    // Until then, leaving the binding avoids a deploy-time class-registration
    // error if Cloudflare's Workflow runtime tries to materialise instances
    // already queued from prior deploys.
    {
      "binding": "PIPELINE_REBUILD_WORKFLOW",
      "name": "rf-mcp-pipeline-rebuild",
      "class_name": "PipelineRebuildWorkflow"
    },
    {
      "binding": "CACHE_SEED_WORKFLOW",
      "name": "rf-mcp-cache-seed",
      "class_name": "CacheSeedWorkflow"
    }
  ],
  // Cron disabled 2026-05-10. Every 15-min tick fired BOTH tail-sync AND
  // PipelineRebuildWorkflow, which INSERT-OR-REPLACEs the entire job_pipelines
  // table (and tail-sync similarly REPLACEs every job in `jobs`) regardless
  // of whether anything actually changed — driving ~1M D1 writes/day with
  // zero active consumers (Joel-only MCP, claude desktop closed). Do NOT
  // re-enable until both sync paths (writeJobs, writeCandidatesAndLinks,
  // writeJobPipeline) are gated to skip unchanged rows (compare new payload
  // hash / last_updated against current row before writing).
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "RF_API_BASE_URL": "https://api.recruiterflow.com/api/external",
    // Feature flag: flip to "true" (or "1") via `wrangler secret put CRON_THIN_ENABLED`
    // (or edit vars + redeploy) to enable the additive INSERT-OR-IGNORE tail-sync path
    // during dual-write cutover phase. Default "false" keeps legacy-only behaviour.
    // After cutover step 6 (Task 30), remove this var and the gate in scheduled().
    "CRON_THIN_ENABLED": "false",
    // Feature flag: gates the LEGACY tailSync (writes to candidates / candidate_jobs
    // / jobs / job_pipelines via INSERT-OR-REPLACE). Default "false" — the
    // legacy writers do not skip unchanged rows and drove the D1 write-storm
    // that disabled cron on 2026-05-10 (see project memory
    // `project_sync_cron_disabled.md`). Re-enable only for explicit cutover
    // diagnostics, via `wrangler secret put CRON_LEGACY_ENABLED` set to
    // "true" (or "1"). After cutover step 6 the legacy code is dropped and
    // this var becomes redundant.
    "CRON_LEGACY_ENABLED": "false",
    "LD_OTLP_TRACES_URL": "https://otel.observability.app.launchdarkly.com/v1/traces",
    "LD_OTLP_LOGS_URL": "https://otel.observability.app.launchdarkly.com/v1/logs"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
