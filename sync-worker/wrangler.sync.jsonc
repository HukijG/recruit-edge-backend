{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rf-mcp-cache-sync",
  "main": "src/sync-worker.js",
  "compatibility_date": "2026-05-04",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "RF_MCP_CACHE",
      "database_name": "rf-mcp-cache",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_STATE",
      "id": "REDACTED_KV_NAMESPACE_ID"
    }
  ],
  "workflows": [
    {
      "binding": "REBUILD_WORKFLOW",
      "name": "rf-mcp-rebuild",
      "class_name": "FullRebuildWorkflow"
    },
    {
      "binding": "PIPELINE_REBUILD_WORKFLOW",
      "name": "rf-mcp-pipeline-rebuild",
      "class_name": "PipelineRebuildWorkflow"
    }
  ],
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "RF_API_BASE_URL": "https://api.recruiterflow.com/api/external"
  },
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 }
  }
}
