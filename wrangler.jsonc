{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rf-dialpad-sync-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-05-10",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "invocation_logs": false
    }
  },
  "vars": {
    "DIALPAD_API_BASE_URL": "https://dialpad.com/api/v2",
    "RF_API_BASE_URL": "https://api.recruiterflow.com/api/external",
    "LD_OTLP_TRACES_URL": "https://otel.observability.app.launchdarkly.com/v1/traces",
    "LD_OTLP_LOGS_URL": "https://otel.observability.app.launchdarkly.com/v1/logs",
    "ACCESS_TEAM_DOMAIN": "https://example-team.cloudflareaccess.com"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": false }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_STATE",
      "id": "REDACTED_KV_NAMESPACE_ID",
      "preview_id": "REDACTED_KV_PREVIEW_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "RF_MCP_CACHE",
      "database_name": "rf-mcp-cache",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "USERS_DB",
      "database_name": "rf-users",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    },
    {
      "binding": "STAGE_EVENTS",
      "database_name": "rf-stage-events",
      "database_id": "00000000-0000-0000-0000-000000000003",
      "migrations_dir": "migrations-stage-events"
    }
  ],
  "triggers": {
    "crons": ["7 * * * *"]
  },
  "services": [
    { "binding": "SYNC_WORKER", "service": "rf-mcp-cache-sync" },
    // Self-binding: the ColdCallArbiter DO alarm calls back into this worker's
    // instrumented fetch handler (POST /internal/coldcall/finalize-cancelled) so
    // the cancelled-cold-call finalize runs in a fully-traced context, span-linked
    // to the originating webhook. DO alarms aren't OTLP-instrumented on their own.
    { "binding": "SELF", "service": "rf-dialpad-sync-dev" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EXT_CALL_STATE", "class_name": "ExtCallState" },
      { "name": "COLD_CALL_ARBITER", "class_name": "ColdCallArbiter" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExtensionCallStateChannel"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ExtensionCallStateChannel"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ExtCallState"]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": ["ColdCallArbiter"]
    }
  ]
}
