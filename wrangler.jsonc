{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rf-dialpad-sync-dev",
  "main": "src/index.js",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "vars": {
    "DIALPAD_API_BASE_URL": "https://dialpad.com/api/v2",
    "RF_API_BASE_URL": "https://api.recruiterflow.com/api/external"
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.md"], "fallthrough": false }
  ],
  "kv_namespaces": [
    {
      "binding": "SYNC_STATE",
      "id": "REDACTED_KV_NAMESPACE_ID",
      "preview_id": "REDACTED_KV_PREVIEW_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "RF_MCP_CACHE",
      "database_name": "rf-mcp-cache",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "USERS_DB",
      "database_name": "rf-users",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations"
    }
  ],
  "services": [
    { "binding": "SYNC_WORKER", "service": "rf-mcp-cache-sync" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "EXT_CALL_STATE", "class_name": "ExtCallState" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExtensionCallStateChannel"]
    },
    {
      "tag": "v2",
      "deleted_classes": ["ExtensionCallStateChannel"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["ExtCallState"]
    }
  ]
}
