# agents@0.12.x peer-requires zod@^4, but we pin zod@^3.25.76 because:
#   1. MCP SDK 1.29 officially supports zod "^3.25 || ^4.0"
#   2. agents/mcp only imports zod as a type (ZodRawShape) — no runtime dep on v4 APIs
#   3. zod 3.25+ ships a /v4 namespace if anything ever needs it
# CI's `npm clean-install` is strict about peer deps; this flag tells it to
# accept the resolution npm chose (zod@3.25.76) instead of failing.
legacy-peer-deps=true
