{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rf-mcp-remote",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-09",
  "compatibility_flags": ["nodejs_compat"],
  "services": [
    { "binding": "MIDDLEWARE", "service": "rf-dialpad-sync-dev" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://example-team.cloudflareaccess.com",
    "LD_OTLP_TRACES_URL": "https://otel.observability.app.launchdarkly.com/v1/traces",
    "LD_OTLP_LOGS_URL": "https://otel.observability.app.launchdarkly.com/v1/logs"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
